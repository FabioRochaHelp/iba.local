# ======================================================================
#  Irmãos da Bola Academy — configuração de PRODUÇÃO
#  Copie para ~/app/.env e ajuste. Permissão recomendada: 600.
# ======================================================================
APP_ENV=production
APP_DEBUG=false
# Endereço público do sistema, com https (usado na proteção contra CSRF)
APP_URL=https://gestao.seudominio.com.br
APP_TIMEZONE=America/Sao_Paulo

# Banco — usuário da APLICAÇÃO (no cPanel: privilégios SELECT, INSERT, UPDATE, DELETE)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_iba
DB_USERNAME=cpaneluser_iba_app
DB_PASSWORD=

# Banco — usuário das MIGRATIONS (no cPanel: ALL PRIVILEGES). Usado só por database/migrate.php
DB_MIGRATE_USERNAME=cpaneluser_iba_mig
DB_MIGRATE_PASSWORD=

# Sessão (SESSION_SECURE=true exige HTTPS)
SESSION_NAME=IBASESSID
SESSION_SECURE=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Financeiro
INVOICE_DUE_DAY=10

# Primeiro administrador (usado uma vez pelo --seed). APAGUE a senha depois.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=
