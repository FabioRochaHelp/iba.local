# Ambiente: local | production
APP_ENV=local
APP_DEBUG=true
# URL pública do sistema (usada na verificação de Origin/Referer contra CSRF)
APP_URL=http://localhost:5173
APP_TIMEZONE=America/Sao_Paulo

# Banco da aplicação (usuário só com SELECT/INSERT/UPDATE/DELETE)
# DB_HOST=127.0.0.1 fora do Docker; no docker-compose.yml o valor é
# sobrescrito para DB_HOST=db (nome do serviço do MySQL na rede interna).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iba
DB_USERNAME=iba_app
DB_PASSWORD=troque-esta-senha

# Usuário das migrations (CREATE/ALTER/DROP/INDEX). Se vazio, usa DB_USERNAME.
DB_MIGRATE_USERNAME=iba_migrate
DB_MIGRATE_PASSWORD=troque-esta-senha-2

# Sessão
SESSION_NAME=IBASESSID
# true obrigatório em produção (HTTPS)
SESSION_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Admin criado pelo seed inicial (apague ADMIN_PASSWORD depois de criar)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@irmaosdabola.com.br
ADMIN_PASSWORD=

# Financeiro: dia de vencimento das mensalidades (1 a 28)
INVOICE_DUE_DAY=10
