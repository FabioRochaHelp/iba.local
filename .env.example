# Portas publicadas no HOST pelo docker-compose.yml. Ajuste se alguma já
# estiver em uso (servidor com vários apps, por exemplo) e rode
# `docker compose up -d` de novo. Não interfere no backend/.env.
#
# Uso: cp .env.example .env   (o Compose carrega ".env" automaticamente)
BACKEND_PORT=8765
FRONTEND_PORT=5173
ADMINER_PORT=8082

# Domínio(s) público(s) atrás de um reverse proxy (nginx/Apache com TLS),
# separados por vírgula. O Vite bloqueia por padrão qualquer Host que não
# seja localhost (proteção contra DNS rebinding). Deixe vazio em dev local.
# Ex.: VITE_ALLOWED_HOSTS=ibacademy.rocksky.com.br
VITE_ALLOWED_HOSTS=
