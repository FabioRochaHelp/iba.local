# =============================================================================
#  Configuração de PRODUÇÃO — copie para ".env.prod" (na raiz) ou use "make env".
#  Gere senhas fortes com:  openssl rand -base64 24
#  Permissão recomendada:   chmod 600 .env.prod
# =============================================================================

# Domínio (DNS tipo A apontando para o IP da VPS) e e-mail para o Let's Encrypt
DOMAIN=gestao.irmaosdabola.com.br
ACME_EMAIL=admin@irmaosdabola.com.br
# Endereço público usado na proteção CSRF. Para aceitar com e sem www:
# APP_URL=https://gestao.irmaosdabola.com.br,https://www.gestao.irmaosdabola.com.br
APP_URL=https://gestao.irmaosdabola.com.br

# Banco de dados (o container MySQL cria tudo isso na 1ª subida)
MYSQL_ROOT_PASSWORD=
DB_DATABASE=iba
DB_USERNAME=iba_app
DB_PASSWORD=
DB_MIGRATE_USERNAME=iba_migrate
DB_MIGRATE_PASSWORD=

# Primeiro administrador (usado uma vez pelo "make seed"). APAGUE a senha depois.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@irmaosdabola.com.br
ADMIN_PASSWORD=

# Sistema
TZ=America/Sao_Paulo
INVOICE_DUE_DAY=10
# true = gera as mensalidades automaticamente todo dia 1º às 06h
AUTO_INVOICES=false
BACKUP_KEEP_DAYS=14
MYSQL_BUFFER_POOL=256M

# Portas públicas (mantenha 80/443 na VPS)
HTTP_PORT=80
HTTPS_PORT=443
